[Unit]
Description=Starlight Sense HAT network display
After=network-online.target
Wants=network-online.target
# Bounded restarts. A misconfigured framebuffer path exits nonzero
# immediately, and with Restart=on-failure alone that becomes a restart
# every RestartSec forever; bounded, it lands in `failed` and stays
# visible in `systemctl status`. See docs/RESILIENCE_PLAN.md,
# "Supervisor Model". These are [Unit] directives -- systemd ignores them
# under [Service].
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=root
WorkingDirectory=/home/jay/pudding/starlight
Environment=STARLIGHT_SIGNAL_SOCKET=/run/starlight/thermal.sock
Environment=STARLIGHT_SIGNAL_SOCKET_OWNER=jay
# The framebuffer is resolved by name at start rather than hardcoded.
# Its index moves with HDMI state and kernel/overlay changes -- this unit
# previously named /dev/fb1, which does not exist on the Pi 4 it was
# installed on, so the service could only ever have failed. systemd does
# no command substitution of its own, hence the `sh -c` wrapper.
ExecStart=/bin/sh -c 'exec /home/jay/pudding/starlight/target/release/starlight eth0 "$(/home/jay/pudding/starlight/scripts/sense-hat-fb.sh)"'
Restart=on-failure
RestartSec=2
# starlight shares this board with GitHub Actions runners, so it must not
# be able to starve a build. Measured on agnes: unbounded, it saturated a
# full core at ~70 packets/sec of ordinary link traffic and made a clean
# rebuild 29% slower (10.1s -> 13.0s).
#
# Nice alone was measured as insufficient (12.2s) -- it is a scheduling
# weight, and with a build's own -j4 threads also runnable it still gets a
# large share. CPUQuota is a hard cgroup ceiling and is what actually
# bounds the damage; Nice makes it yield promptly within that ceiling.
#
# The in-process frame gate (STARLIGHT_MIN_FRAME_INTERVAL_MS) is the real
# fix and normally keeps usage far below this. The quota is the backstop
# for when it is misconfigured or disabled.
CPUQuota=25%
Nice=19
IOSchedulingClass=idle
# A framebuffer retains its last frame after the writer exits, so a
# stopped or crashed starlight otherwise leaves a stale pattern lit on the
# HAT that is indistinguishable from a hung process. ExecStopPost runs on
# every stop path including SIGKILL and crashes, which an in-process
# signal handler would not cover.
ExecStopPost=/home/jay/pudding/starlight/scripts/blank-sense-hat.sh
RuntimeDirectory=starlight
RuntimeDirectoryMode=0775
NoNewPrivileges=false

[Install]
WantedBy=multi-user.target
